# Local single-user studio. Run npm run dev:studio.
# Detailed instructions: docs/SETUP_AND_USAGE.md
# Never put real credentials in this example file.
STUDIO_HOST=127.0.0.1
STUDIO_PORT=4311
STUDIO_DATA_DIR=./data
STUDIO_ORIGIN=http://localhost:3001
# Optional local studio password; use a random token of at least 32 characters.
# Required (at least 32 characters) if binding beyond loopback.
# Restart the studio after editing .env, then use Unlock studio in the browser.
STUDIO_TOKEN=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WORKER_CONCURRENCY=2
JOB_TIMEOUT_MS=180000
# Opt-in OpenAI concepts, scripts, storyboards and speech.
# See docs/OPENAI_SETUP.md. A key alone never changes existing project providers.
OPENAI_API_KEY=
OPENAI_TIMEOUT_MS=90000
# Runway Gen-4.5 video (opt-in per project). See docs/MVP_QUICKSTART.md.
RUNWAY_API_KEY=
# Reserved, unimplemented other provider integrations. Leave these blank.
VIDEO_PROVIDER_API_KEY=
VOICE_PROVIDER_API_KEY=
# ElevenLabs narration and Eleven Music (opt-in per project). See docs/AUDIO_SETUP.md.
ELEVENLABS_API_KEY=
# Budget estimates; adjust to your account's rates. Not provider invoices.
ELEVENLABS_TTS_USD_PER_1000=0.10
ELEVENLABS_MUSIC_USD_PER_MINUTE=0.15
